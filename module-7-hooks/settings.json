{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash-firewall.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-write-path-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-write-secret-scan.sh"
          }
        ]
      }
    ]
  }
}
